# AD-FLEX local demo environment example.
# Copy this file to .env for Docker Compose overrides.
# Do not put real production secrets in this file.

# ---------------------------------------------------------------------------
# Kafka
# ---------------------------------------------------------------------------
KAFKA_BROKERS=kafka:29092
KAFKA_CLIENT_ID=adflex-production-foundation
RAW_TELEMETRY_TOPIC=raw.telemetry
NORMALIZED_TELEMETRY_TOPIC=normalized.telemetry
SEMANTIC_ENRICHED_TOPIC=semantic.enriched
SEMANTIC_RETRY_TOPIC=semantic.mapping.retry
SEMANTIC_DLQ_TOPIC=semantic.mapping.dlq
KAFKA_DEFAULT_PARTITIONS=12
IEEE20305_TRANSLATED_TOPIC=ieee20305.translated
GRID_SIGNALS_TOPIC=grid.signals
DISPATCH_PROPOSED_TOPIC=dispatch.command.proposed
DISPATCH_AUDIT_TOPIC=dispatch.command.audit
DISPATCH_READY_TOPIC=dispatch.command.ready
DISPATCH_APPROVAL_AUDIT_TOPIC=dispatch.approval.audit
DISPATCH_MOCK_SENT_TOPIC=dispatch.command.mock.sent
DISPATCH_MOCK_RESULT_TOPIC=dispatch.command.mock.result
DISPATCH_MOCK_AUDIT_TOPIC=dispatch.mock.audit
DEVICE_COMMAND_RESULT_TOPIC=device.command.result
DEVICE_COMMAND_AUDIT_TOPIC=device.command.audit
SECURITY_GATEWAY_AUDIT_TOPIC=security.gateway.audit
DATASPACE_CATALOG_TOPIC=dataspace.catalog
DATASPACE_EXPORT_AUDIT_TOPIC=dataspace.export.audit

# ---------------------------------------------------------------------------
# TimescaleDB / PostgreSQL
# ---------------------------------------------------------------------------
TIMESCALE_HOST=timescaledb
TIMESCALE_PORT=5432
TIMESCALE_DB=energy_flex
TIMESCALE_USER=energy_user
TIMESCALE_PASSWORD=energy_password

# ---------------------------------------------------------------------------
# Ingestion and MQTT
# ---------------------------------------------------------------------------
INGESTION_API_PORT=3001
REQUEST_BODY_LIMIT=256kb
MQTT_BROKER_URL=mqtt://mqtt-broker:1883
MQTT_TOPIC_FILTER=telemetry/#

# ---------------------------------------------------------------------------
# Engine and semantic connector
# ---------------------------------------------------------------------------
ENGINE_GROUP_ID=energy-flex-engine
SEMANTIC_CONNECTOR_GROUP_ID=saref4ener-semantic-connector

# ---------------------------------------------------------------------------
# Local SLM-primary semantic interpretation.
# If Ollama is unavailable, deterministic SAREF4ENER fallback keeps the demo running.
# ---------------------------------------------------------------------------
SLM_ENABLED=true
SLM_PRIMARY=true
SLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
SLM_MODEL=phi3:mini
OLLAMA_MODEL=phi3:mini
SLM_TIMEOUT_MS=30000
SLM_MIN_CONFIDENCE=0.70
SLM_BATCH_MAX_READINGS=8
SLM_BATCH_MAX_WAIT_MS=20
SLM_BATCH_MAX_PROMPT_TOKENS=4096
SLM_BATCH_MAX_RETRIES=2
SLM_MAX_OUTPUT_TOKENS=8192
SLM_PROVIDER_MAX_CONCURRENCY=1
SLM_CIRCUIT_FAILURE_THRESHOLD=5
SLM_CIRCUIT_COOLDOWN_MS=30000
SLM_WARMUP_ENABLED=true
VLLM_BASE_URL=http://host.docker.internal:8000
VLLM_MODEL=microsoft/Phi-3-mini-4k-instruct
VLLM_API_KEY=
SEMANTIC_PARTITIONS_CONCURRENTLY=2
SEMANTIC_KAFKA_SESSION_TIMEOUT_MS=180000
SEMANTIC_KAFKA_HEARTBEAT_MS=3000
SEMANTIC_KAFKA_MAX_BYTES_PER_PARTITION=1048576
SEMANTIC_TIMESCALE_POOL_SIZE=10

# ---------------------------------------------------------------------------
# Phase 4 IEEE 2030.5-style translator foundation
# ---------------------------------------------------------------------------
IEEE20305_TRANSLATOR_PORT=3002

# ---------------------------------------------------------------------------
# Phase 5 aggregator proposal service
# ---------------------------------------------------------------------------
AGGREGATOR_PORT=3003

# ---------------------------------------------------------------------------
# Phase 6 approval workflow service
# ---------------------------------------------------------------------------
APPROVAL_WORKFLOW_PORT=3004

# ---------------------------------------------------------------------------
# Phase 7 safe mock dispatch adapter
# ---------------------------------------------------------------------------
MOCK_DISPATCH_ADAPTER_PORT=3005

# ---------------------------------------------------------------------------
# Production alignment local security edge
# API key is local development only, not production security.
# ---------------------------------------------------------------------------
SECURITY_GATEWAY_PORT=3010
EDGE_API_KEY=local-dev-edge-key
EDGE_RATE_LIMIT_WINDOW_MS=60000
EDGE_RATE_LIMIT_MAX_REQUESTS=120
EDGE_IP_ALLOWLIST=
EDGE_IP_BLOCKLIST=
EDGE_REQUEST_BODY_LIMIT=256kb
JWT_AUTH_ENABLED=false
JWT_ISSUER=
JWT_AUDIENCE=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CUSTOMER_DASHBOARD_PSEUDONYMIZATION_SALT=local-dashboard-salt
CUSTOMER_INSIGHT_REFRESH_MINUTES=60
CUSTOMER_INSIGHT_TIMEOUT_MS=20000
CUSTOMER_SCALE_COHORT_PREFIX=scale1000-

# ---------------------------------------------------------------------------
# Simulated device API translation
# No real Shelly or Enode credentials are used.
# ---------------------------------------------------------------------------
SHELLY_SIMULATOR_PORT=3007
ENODE_SIMULATOR_PORT=3008
HEAT_PUMP_SIMULATOR_PORT=3011
HOUSEHOLD_FLEET_SIMULATOR_PORT=3012
DEVICE_COMMAND_TRANSLATOR_PORT=3009
SHELLY_SIMULATOR_URL=http://shelly-simulator:3007
ENODE_SIMULATOR_URL=http://enode-simulator:3008
HEAT_PUMP_SIMULATOR_URL=http://heat-pump-simulator:3011

# Bounded household fleet simulator. One process represents all virtual devices.
FLEET_HOUSEHOLD_COUNT=20
FLEET_RANDOM_SEED=20260724
FLEET_REPORTING_INTERVAL_MS=180000
FLEET_SCHEDULER_TICK_MS=250
FLEET_MAX_IN_FLIGHT=8
FLEET_AUTOSTART=true
FLEET_COMMUNITY_ID=community-dublin-north
FLEET_HOUSEHOLD_PREFIX=demo-household
FLEET_AREA_PREFIX=dublin-north

# ---------------------------------------------------------------------------
# Customer console public-demo authentication (server-side only)
# ---------------------------------------------------------------------------
DEMO_USERNAME=operator
DEMO_PASSWORD=operator123
DEMO_SESSION_SECRET=local-dev-session-secret-change-me
DEMO_LOGIN_WINDOW_MS=60000
DEMO_LOGIN_MAX_ATTEMPTS=8
PUBLIC_DEMO_MODE=false

# ---------------------------------------------------------------------------
# Phase 8 dataspace-style export foundation
# API key is local development only, not production security.
# ---------------------------------------------------------------------------
DATASPACE_EXPORT_PORT=3006
DATASPACE_API_KEY=local-dev-dataspace-key
DATASPACE_DEFAULT_COMMUNITY=community-dublin-north
DATASPACE_PSEUDONYMIZATION_SALT=local-dev-salt
DATASPACE_MAX_RECORDS=100
