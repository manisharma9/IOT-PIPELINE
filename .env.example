# AD-FLEX local demo environment example.
# Copy this file to .env for Docker Compose overrides.
# Do not put real production secrets in this file.

# ---------------------------------------------------------------------------
# Kafka
# ---------------------------------------------------------------------------
KAFKA_BROKERS=kafka:29092
KAFKA_CLIENT_ID=adflex-production-foundation
RAW_TELEMETRY_TOPIC=raw.telemetry
NORMALIZED_TELEMETRY_TOPIC=normalized.telemetry
SEMANTIC_ENRICHED_TOPIC=semantic.enriched
IEEE20305_TRANSLATED_TOPIC=ieee20305.translated
GRID_SIGNALS_TOPIC=grid.signals
DISPATCH_PROPOSED_TOPIC=dispatch.command.proposed
DISPATCH_AUDIT_TOPIC=dispatch.command.audit
DISPATCH_READY_TOPIC=dispatch.command.ready
DISPATCH_APPROVAL_AUDIT_TOPIC=dispatch.approval.audit
DISPATCH_MOCK_SENT_TOPIC=dispatch.command.mock.sent
DISPATCH_MOCK_RESULT_TOPIC=dispatch.command.mock.result
DISPATCH_MOCK_AUDIT_TOPIC=dispatch.mock.audit
DATASPACE_CATALOG_TOPIC=dataspace.catalog
DATASPACE_EXPORT_AUDIT_TOPIC=dataspace.export.audit

# ---------------------------------------------------------------------------
# TimescaleDB / PostgreSQL
# ---------------------------------------------------------------------------
TIMESCALE_HOST=timescaledb
TIMESCALE_PORT=5432
TIMESCALE_DB=energy_flex
TIMESCALE_USER=energy_user
TIMESCALE_PASSWORD=energy_password

# ---------------------------------------------------------------------------
# Ingestion and MQTT
# ---------------------------------------------------------------------------
INGESTION_API_PORT=3001
REQUEST_BODY_LIMIT=256kb
MQTT_BROKER_URL=mqtt://mqtt-broker:1883
MQTT_TOPIC_FILTER=telemetry/#

# ---------------------------------------------------------------------------
# Engine and semantic connector
# ---------------------------------------------------------------------------
ENGINE_GROUP_ID=energy-flex-engine
SEMANTIC_CONNECTOR_GROUP_ID=saref4ener-semantic-connector

# ---------------------------------------------------------------------------
# Optional Phase 3 SLM-assisted mapping for unknown semantic readings
# Known readings do not require Ollama.
# ---------------------------------------------------------------------------
SLM_ENABLED=true
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=phi3:mini
SLM_TIMEOUT_MS=8000

# ---------------------------------------------------------------------------
# Phase 4 IEEE 2030.5-style translator foundation
# ---------------------------------------------------------------------------
IEEE20305_TRANSLATOR_PORT=3002

# ---------------------------------------------------------------------------
# Phase 5 aggregator proposal service
# ---------------------------------------------------------------------------
AGGREGATOR_PORT=3003

# ---------------------------------------------------------------------------
# Phase 6 approval workflow service
# ---------------------------------------------------------------------------
APPROVAL_WORKFLOW_PORT=3004

# ---------------------------------------------------------------------------
# Phase 7 safe mock dispatch adapter
# ---------------------------------------------------------------------------
MOCK_DISPATCH_ADAPTER_PORT=3005

# ---------------------------------------------------------------------------
# Phase 8 dataspace-style export foundation
# API key is local development only, not production security.
# ---------------------------------------------------------------------------
DATASPACE_EXPORT_PORT=3006
DATASPACE_API_KEY=local-dev-dataspace-key
DATASPACE_DEFAULT_COMMUNITY=community-dublin-north
DATASPACE_PSEUDONYMIZATION_SALT=local-dev-salt
DATASPACE_MAX_RECORDS=100
