# Phase 1 production foundation defaults.
# Copy this file to .env for local Docker Compose overrides.
# Do not put real secrets in this example file.

# HTTP ingestion API
INGESTION_API_PORT=3001
REQUEST_BODY_LIMIT=256kb

# Kafka
RAW_TELEMETRY_TOPIC=raw.telemetry
KAFKA_BROKERS=kafka:29092
KAFKA_CLIENT_ID=adflex-production-foundation
ENGINE_GROUP_ID=energy-flex-engine

# MQTT
MQTT_BROKER_URL=mqtt://mqtt-broker:1883
MQTT_TOPIC_FILTER=telemetry/#

# TimescaleDB / PostgreSQL
TIMESCALE_HOST=timescaledb
TIMESCALE_PORT=5432
TIMESCALE_DB=energy_flex
TIMESCALE_USER=energy_user
TIMESCALE_PASSWORD=energy_password
